DATABASE_URL=sqlite:///./eti.db
DATA_MAX_AGE_SECONDS=300
LIVE_TRADING_ENABLED=false

# Alpaca paper account only. Never commit real credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_PAPER_ORDER_ROUTING_ENABLED=false
ALPACA_DATA_FEED=iex

# Binance public market data works without credentials.
# Private account and testnet order features require testnet credentials.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET_ENABLED=false
BINANCE_TESTNET_ORDER_ROUTING_ENABLED=false
BINANCE_PUBLIC_BASE_URL=https://api.binance.com
PROVIDER_TIMEOUT_SECONDS=12
